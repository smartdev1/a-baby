# Role: example environment variables (fake values only — copy to .env, never commit real secrets).

# --- apps/services ---
SERVICES_HOST=127.0.0.1
SERVICES_PORT=8080
SERVICES_CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SESSION_TICKETS_PER_MIN=10
SKYLINE_CONTENT_DIR=./content
SKYLINE_RUNTIME_DIR=./data/runtime

# --- packages/db (from J6) ---
DATABASE_URL=postgresql://skyline:change-me@localhost:5432/skyline?schema=public

# --- packages/bus (from J5) ---
NATS_URL=nats://localhost:4222

# --- apps/gateway / apps/all-in-one (J1) ---
GATEWAY_PORT=2567
SKYLINE_WORLD_DIR=./data/build/yopougon/stages
SKYLINE_SPAWN_LONLAT=-4.0681,5.329
