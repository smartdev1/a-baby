# Environment variables for SKYLINE - Abidjan District
# Copy this file to .env and fill in the actual values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/skyline?schema=public"

# Server
PORT=2567
NODE_ENV=development

# Colyseus monitoring (optional)
COLOYSEUS_MONITOR_USERNAME=admin
COLOYSEUS_MONITOR_PASSWORD=password

# JWT secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Game configuration
GAME_WORLD_SIZE=300
MAX_PLAYERS_PER_SESSION=8
TEST_MAX_PLAYERS_PER_SESSION=12

# Mission rewards (in Djai)
MISSION_01_REWARD_DJAI=500
MISSION_01_REWARD_REPUTATION=100

# Activity rewards
ACTIVITY_DELIVERY_REWARD=100
ACTIVITY_SEARCH_REWARD=75
ACTIVITY_SERVICE_REWARD=150

# Economy
STARTING_DJAI_BALANCE=0
STARTING_REPUTATION=0
DEFAULT_HEALTH=100
MAX_HEALTH=100