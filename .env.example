# Role: example environment variables (fake values only — copy to .env, never commit real secrets).

# --- apps/services ---
SERVICES_HOST=127.0.0.1
SERVICES_PORT=8080
SERVICES_CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SESSION_TICKETS_PER_MIN=10
# Internal routes for gateways in other processes (multi-process mode), loopback only
SERVICES_INTERNAL_ROUTES=false
# Session tickets without a guest account: local dev / load tests only (the all-in-one defaults to true), never in production
SKYLINE_ANONYMOUS_TICKETS=false
SKYLINE_CONTENT_DIR=./content
SKYLINE_RUNTIME_DIR=./data/runtime

# --- packages/db (from J6) ---
DATABASE_URL=postgresql://skyline:change-me@localhost:5432/skyline?schema=public

# --- packages/bus (multi-process mode, T-110) ---
NATS_URL=nats://localhost:4222

# --- apps/gateway / apps/all-in-one (J1) ---
GATEWAY_PORT=2567
SKYLINE_WORLD_DIR=./data/build/yopougon/stages
SKYLINE_SPAWN_LONLAT=-4.0681,5.329

# --- apps/zone and apps/gateway standalone processes (multi-process mode, T-110) ---
SERVICES_URL=http://127.0.0.1:8080
ZONE_CELLS=C_81_49
CLUSTER_CELLS=C_81_49,C_82_49
SPAWN_UTM=381940,589300
ZONE_STATS_PORT=0
SPAWN_CELL=C_81_49

# --- tools/map-pipeline (T-201) ---
# Worker threads for per-tile stages (encode, lod-build); empty = available cores - 1, 0 = main thread only
SKYLINE_PIPELINE_WORKERS=
