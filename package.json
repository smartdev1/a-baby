{
  "name": "skyline",
  "version": "0.1.0",
  "description": "vie virtuelle 3D web — Yopougon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @skyline/web dev",
    "dev:services": "pnpm --filter @skyline/services dev",
    "map:build": "tsx tools/map-pipeline/src/cli/main.ts build",
    "content:validate": "tsx tools/content-cli/src/cli.ts validate",
    "content:compile": "tsx tools/content-cli/src/cli.ts compile",
    "content:schemas": "tsx tools/content-cli/src/cli.ts schemas",
    "map:osmium-image": "docker build -t skyline/osm-tools:2 infra/docker/osmium",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && depcruise apps packages tools --config .dependency-cruiser.cjs && node tools/repo-checks/src/run-all.mjs && node scripts/check-prohibited-names.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "check:repo": "node tools/repo-checks/src/run-all.mjs",
    "check:folder-size": "node scripts/check-folder-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
