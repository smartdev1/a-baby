  "description": "Offline CLI: frozen OSM snapshot -> normalized, classified, named features -> 250 m tiles (geometry, collisions, metadata, manifest).",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@skyline/geo": "workspace:*",
    "@skyline/observability": "workspace:*",
    "@skyline/tile-format": "workspace:*",
    "earcut": "^3.2.4",
    "flatbush": "^4.6.2",
    "meshoptimizer": "^1.3.0",
    "polygon-clipping": "^0.15.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/earcut": "^3.2.4",
    "@types/geojson": "^7946.0.16"
