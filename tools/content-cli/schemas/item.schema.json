{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "basePriceDjai": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "category": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "type": "string"
    },
    "labelKey": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
      "type": "string"
    },
    "maxStack": {
      "maximum": 999,
      "minimum": 1,
      "type": "integer"
    },
    "stackable": {
      "type": "boolean"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "labelKey",
    "category",
    "stackable",
    "maxStack"
  ],
  "type": "object"
}
