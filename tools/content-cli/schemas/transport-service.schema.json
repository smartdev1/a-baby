{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cruiseKmh": {
      "maximum": 80,
      "minimum": 5,
      "type": "number"
    },
    "dwellGameMin": {
      "maximum": 60,
      "minimum": 0,
      "type": "number"
    },
    "fareDjai": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "enum": [
        "gbaka",
        "woro_woro",
        "sotra_bus",
        "bus"
      ],
      "type": "string"
    },
    "labelKey": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$",
      "type": "string"
    },
    "periods": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^24:00$",
            "type": "string"
          },
          "headwayGameMin": {
            "maximum": 240,
            "minimum": 1,
            "type": "integer"
          },
          "to": {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^24:00$",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "headwayGameMin"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "seats": {
      "maximum": 120,
      "minimum": 1,
      "type": "integer"
    },
    "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "labelKey",
    "cruiseKmh",
    "dwellGameMin",
    "seats",
    "fareDjai",
    "periods"
  ],
  "type": "object"
}
