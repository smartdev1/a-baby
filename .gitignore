# Role: files and folders git must never track (dependencies, builds, secrets, generated map data, local agent role).

# Dependencies and builds
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/
playwright-report/
test-results/

# Environment and secrets
.env
.env.*
!.env.example

# Map pipeline: downloads and generated tiles are never committed (only data/sources/sources.lock.json)
data/cache/
data/build/
data/runtime/

# Local Claude Code state (each developer declares their own role)
.claude/role.local
.claude/*.lock
.claude/settings.local.json
CLAUDE.local.md

# Logs and OS noise
*.log
logs/
.DS_Store
Thumbs.db
Desktop.ini
